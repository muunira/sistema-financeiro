{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/app.html", "destination": "/app.html" },
    { "source": "/((?!assets/|css/|js/|.*\\.(?:html|png|jpg|jpeg|gif|ico|svg|css|js|json|txt|pdf|zip|woff|woff2|ttf|eot|otf)$).+)", "destination": "/app.html" }
  ]
}
